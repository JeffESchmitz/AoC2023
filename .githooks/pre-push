#!/bin/sh
#
# Block pushes whose new commits contain Advent of Code puzzle input or the
# session cookie. Second line of defense after pre-commit, and it also catches
# commits made with --no-verify or by tools that skip hooks.
# Matching rules are in .githooks/aoc-input-scan; reviewed exceptions in .git/info/aoc-allowlist.
#
# Turned on per clone by ./setup (git config core.hooksPath .githooks).
# Bypass (don't): git push --no-verify

export LC_ALL=C
REMOTE="$1"
SCAN="$(dirname "$0")/aoc-input-scan"
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
NAMES=$(mktemp) && PATCH=$(mktemp) || { echo "pre-push: mktemp failed. Push blocked." >&2; exit 1; }
trap 'rm -f "$NAMES" "$PATCH"' EXIT
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue  # deleting a remote branch

    if [ "$remote_sha" = "$ZERO" ]; then
        # New remote branch: every commit the remote doesn't already have.
        range="$local_sha --not --remotes=$REMOTE"
    else
        range="$remote_sha..$local_sha"
    fi

    # $range is intentionally unquoted so it splits into rev-list arguments.
    # Merges are diffed against their first parent so conflict resolutions count.
    # Pass 1: changed paths (catches pure renames, which have no patch text).
    # Pass 2: every added line. If git can't list the commits, block (fail closed).
    # shellcheck disable=SC2086
    if ! git log --diff-merges=first-parent --no-renames --name-only --diff-filter=ACMR \
            --format='commit %h' $range >"$NAMES" ||
       ! git log --diff-merges=first-parent -U0 --no-color --no-ext-diff \
            --format='commit %h' $range >"$PATCH"; then
        echo "pre-push: could not list commits for $remote_ref. Push blocked to be safe." >&2
        status=1
        continue
    fi
    if ! {
        awk '/^commit / { sha = $2; next }
             NF         { print sha "\t" $0 "\t" }' "$NAMES"
        awk '/^commit / { sha = $2; next }
             /^\+\+\+ / { file = substr($0, 7); next }
             /^\+/      { print sha "\t" file "\t" substr($0, 2) }' "$PATCH"
    } | "$SCAN"; then
        echo "pre-push: commits for $remote_ref contain AoC puzzle input (above). Push blocked." >&2
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "Remove the input from those commits (rewrite them) before pushing. Never push puzzle input." >&2
fi
exit $status
