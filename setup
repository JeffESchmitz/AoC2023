#!/bin/sh
#
# One-time setup for each new clone: turn on the hooks that keep Advent of Code
# puzzle input out of commits and pushes. Safe to run again. See .githooks/README.md.

set -e
cd "$(git rev-parse --show-toplevel)"

chmod +x .githooks/pre-commit .githooks/pre-push .githooks/aoc-input-scan
git config core.hooksPath .githooks
echo "AoC input guard hooks on (core.hooksPath = $(git config core.hooksPath))"

for f in .aoc-session Sources/Inputs/Day01+Input.swift; do
    if ! git check-ignore -q --no-index "$f"; then
        echo "WARNING: $f is not gitignored. Fix .gitignore before downloading input." >&2
    fi
done

if [ ! -s .aoc-session ]; then
    echo "Next: put your AoC session cookie in .aoc-session (private, gitignored), then ./input.sh <day>."
fi
